{
  "name": "crimeledger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "refresh:data": "python3 scripts/refresh_data.py",
    "validate:data": "python3 scripts/refresh_data.py --validate-only"
  },
  "dependencies": { "react": "19.2.8", "react-dom": "19.2.8", "lucide-react": "1.38.0" },
  "devDependencies": { "@types/react": "19.2.18", "@types/react-dom": "19.2.5", "@vitejs/plugin-react": "6.1.1", "typescript": "7.0.2", "vite": "8.2.2" }
}
